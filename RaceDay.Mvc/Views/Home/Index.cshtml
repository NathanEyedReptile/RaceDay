@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-hero">
            <div class="col-lg-7">
                <div class="hero-tag">
                    <span class="live-dot"></span>
                    YOUR NEXT CHALLENGE STARTS HERE
                </div>

                <h1>
                    FIND YOUR<br />
                    <span>FINISH LINE.</span>
                </h1>

                <p class="hero-description">
                    Discover events, challenge yourself and join a community
                    of people who refuse to stand still.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="#upcoming" class="btn btn-raceday btn-lg">
                        Explore Events <span>→</span>
                    </a>
                    <a href="#about" class="btn btn-outline-light btn-lg">
                        Discover RaceDay
                    </a>
                </div>
            </div>

            <div class="col-lg-5 hero-visual d-none d-lg-flex">
                <div class="hero-number">01</div>
                <div class="hero-vertical-text">PUSH YOUR LIMITS</div>
                <div class="hero-circle">
                    <span>R</span>
                </div>
                <div class="hero-bottom-label">READY. SET. RACE.</div>
            </div>
        </div>
    </div>
</section>

<section class="stats-strip">
    <div class="container">
        <div class="row text-center">
            <div class="col-4 stat-item">
                <h3>01</h3>
                <p>ONE STARTING LINE</p>
            </div>
            <div class="col-4 stat-item">
                <h3>100%</h3>
                <p>YOUR OWN PACE</p>
            </div>
            <div class="col-4 stat-item">
                <h3>∞</h3>
                <p>POSSIBILITIES</p>
            </div>
        </div>
    </div>
</section>

<section class="upcoming-section" id="upcoming">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="section-kicker">WHAT'S ON THE CALENDAR?</span>
                <h2>UPCOMING <span>EVENTS.</span></h2>
            </div>
            <span class="section-index">01 / EVENTS</span>
        </div>

        <div class="empty-events">
            <div class="empty-events-icon">🏁</div>
            <h3>THE STARTING LINE IS OPEN.</h3>
            <p>Upcoming events will appear here. Check back for your next challenge.</p>
        </div>
    </div>
</section>

<section class="about-section" id="about">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-kicker">MORE THAN JUST A RACE</span>
                <h2>BUILT FOR THE<br /><span>DRIVE TO DO MORE.</span></h2>
            </div>
            <div class="col-lg-6">
                <p>
                    RaceDay brings event organisers and participants together.
                    Discover competitions, register for events and keep track
                    of your performance, all in one place.
                </p>
            </div>
        </div>
    </div>
</section>